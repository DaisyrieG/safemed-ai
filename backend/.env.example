# Copy to backend/.env (git-ignored) and fill in ONE of the options below.

# Option A: OpenAI GPT-4o-mini (as specified in Chapter 3)
OPENAI_API_KEY=sk-your-key-here

# Option B: local Qwen through LM Studio (Developer tab -> Start Server)
# SAFEMED_LLM_BASE_URL=http://localhost:1234/v1
# SAFEMED_LLM_MODEL=qwen2.5-7b-instruct

# Option C: local Qwen through Ollama
# SAFEMED_LLM_BASE_URL=http://localhost:11434/v1
# SAFEMED_LLM_MODEL=qwen2.5:7b

# Demo backup: allow a clearly labelled offline answer if no LLM is reachable
# SAFEMED_ALLOW_OFFLINE=1

# Retrieval corpus for the web demo
#   demo     (default) 1,000 real PubMedQA abstracts with real PMIDs; sample cases are PubMedQA test questions.
#            Labelled harmful documents from scripts/generate_harmful_docs.py are added automatically.
#   sample   57 hand-written illustrative documents (placeholder PMIDs, obvious harmful examples)
#   pubmedqa 5,000 pqa_artificial abstracts used by the benchmark
# SAFEMED_CORPUS=demo
